# 本地无需账号；公网部署使用 server 模式和 HTTPS。
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8010
DEPLOYMENT_MODE=local
PUBLIC_ORIGIN=
SESSION_SECURE_COOKIE=true
EXECUTION_SANDBOX=false
# 默认使用本地 SQLite，无需数据库服务器或 SSH 隧道。
DATABASE_URL=sqlite+aiosqlite:///./data/repromind.db
LANGGRAPH_CHECKPOINT_URL=
DEFAULT_TENANT_ID=tenant_default

# 暂未启用的基础设施；真正需要相应业务能力时再配置。
REDIS_URL=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=repromind
MILVUS_URI=
MILVUS_DB_NAME=repromind
MILVUS_COLLECTION_NAME=research_evidence

UPLOAD_DIR=./data/uploads
PAPER_PROJECTS_DIR=./data/paper-projects
MAX_UPLOAD_MB=40
GIT_CLONE_TIMEOUT_SECONDS=45
REPRODUCTION_TIMEOUT_SECONDS=900
# 数据下载：单次下载总时限、连续无数据等待、连接等待（秒）；含已批准来源的重试。
DATASET_DOWNLOAD_TIMEOUT_SECONDS=1800
DATASET_DOWNLOAD_READ_TIMEOUT_SECONDS=180
DATASET_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=60
REPRODUCTION_LOG_CHARS=60000
# 数值判定：practical 默认比例指标 1 个百分点、其他指标目标值的 5%；strict 仅保留论文不确定性。
# 每次准备任务时记录该策略；不改写历史结果，也不据此宣称所有论文结论已验证。
REPRODUCTION_COMPARISON_MODE=practical
REPRODUCTION_RATIO_TOLERANCE=0.01
REPRODUCTION_RELATIVE_TOLERANCE=0.05
HF_ENDPOINT=https://hf-mirror.com
# 可选：软件包索引。留空沿用 pip 配置；慢速网络可指定可信 HTTPS 镜像。
PIP_INDEX_URL=

# openai_compatible：开发阶段使用兼容接口；moma：比赛环境使用移动云 MoMA。
MODEL_PROVIDER=openai_compatible

# OpenAI-compatible LLM service. Keep secrets only in your local .env.
LLM_API_KEY=
# DEEPSEEK_API_KEY=  # 也兼容此变量名
LLM_BASE_URL=https://api.chatanywhere.tech/v1
LLM_MODEL_CHAT=gpt-4o-mini
LLM_MODEL_CODER=gpt-4o-mini
LLM_MODEL_REASONING=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS_PER_CALL=8192

# 移动云 MoMA（申请账号后填写；接口为 OpenAI 兼容格式）
MOMA_API_KEY=
MOMA_BASE_URL=https://zhenze-huhehaote.cmecloud.cn/v1
MOMA_MODEL_ROUTER=deepseek-v4-flash-0731
MOMA_MODEL_CHAT=deepseek-v4-flash-0731
MOMA_MODEL_CODER=deepseek-v4-flash-0731
MOMA_MODEL_REASONING=deepseek-v4-flash-0731

# Frontend (used by Vite)
VITE_API_BASE_URL=/api
# 开发前端的代理目标，必须与 APP_PORT 一致。
VITE_BACKEND_URL=http://127.0.0.1:8010
